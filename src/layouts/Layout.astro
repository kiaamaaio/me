---
import { siteConfig } from '../data/site';

interface Props {
    title?: string;
    description: string;
    ogImage?: string;
}

const { title, description, ogImage = '/og-image.jpg' } = Astro.props;

const pageTitle = title ? `${title} | ${siteConfig.name}` : siteConfig.name;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<html lang="ja">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#a9855c" />
    <title>{pageTitle}</title>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={canonicalUrl} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />

    <!-- フォントの読み込み -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap" rel="stylesheet">
</head>

<body>
<slot />
{cfBeaconToken && (
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js"
            data-cf-beacon={`{"token": "${cfBeaconToken}"}`}></script>
)}
</body>

<style is:global>
    /* グローバルリセット & ベーススタイル */
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    /* 欧文は Inter、和文は Inter にグリフが無いため OS 標準の和文フォントへ明示的にフォールバックする
       （指定しないとブラウザ既定の和文フォントに落ちて環境ごとに字面と太さが変わる） */
    html {
        color-scheme: light;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
        'Hiragino Sans', 'Hiragino Kaku Gothic ProN', 'Noto Sans JP',
        'Yu Gothic Medium', 'Yu Gothic', Meiryo, sans-serif;
        line-height: 1.6;
    }

    /* ページ全体を縦方向のフレックスにして、フッターを常に最下部へ置く。
       下端は白いフッター文字のコントラストを確保するために少し暗く落とす */
    body {
        background:
            linear-gradient(to bottom, rgba(0, 0, 0, 0) 55%, rgba(0, 0, 0, 0.22) 100%),
            linear-gradient(135deg, #dcc196 0%, #a9855c 55%, #6f5539 100%);
        min-height: 100vh;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        color: #333;
    }

    /* 表示時にわずかに持ち上げながらフェードインさせる。
       遅延は各ページ側で指定して段差をつける */
    @keyframes rise-in {
        from {
            opacity: 0;
            transform: translateY(12px);
        }
        to {
            opacity: 1;
            transform: none;
        }
    }

    .card,
    .footer {
        animation: rise-in 0.5s ease-out both;
    }

    /* 共通のカードスタイル */
    .card {
        background: rgba(255, 255, 255, 0.95);
        padding: 2.5rem;
        border-radius: 20px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    }

    .card h2 {
        text-align: center;
        font-size: 1.75rem;
        margin-bottom: 2rem;
        color: #333;
    }

    /* アニメーションを抑制する設定を尊重する */
    @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
            animation-duration: 0.01ms !important;
            animation-delay: 0s !important;
            animation-iteration-count: 1 !important;
            transition-duration: 0.01ms !important;
            scroll-behavior: auto !important;
        }
    }

    @media (max-width: 768px) {
        .card {
            padding: 2rem 1.5rem;
        }
    }

    @media (max-width: 480px) {
        .card {
            padding: 1.5rem 1rem;
        }
    }
</style>
</html>