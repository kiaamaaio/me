---
import { profileData } from '../data/profile';

const { name, location, profileImage } = profileData;
---

<section class="hero card">
    <div class="profile-image">
        <img
                src={profileImage}
                alt="プロフィール写真"
                width="200"
                height="200"
        />
    </div>

    <h1 class="name">{name}</h1>
    <p class="location">{location}</p>
</section>

<style>
    .hero {
        text-align: center;
        padding: 3rem 2rem;
    }

    .profile-image {
        margin-bottom: 2rem;
    }

    .profile-image img {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #fff;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
        transition: transform 0.3s ease;
    }

    .profile-image img:hover {
        transform: scale(1.05);
    }

    .name {
        /* 320px 幅でも「ごろむ」が途中で折れないところまで縮める */
        font-size: clamp(1.5rem, 7vw, 2.5rem);
        font-weight: 700;
        line-height: 1.3;
        word-break: keep-all;
        text-wrap: balance;
        margin-bottom: 0.5rem;
        background: linear-gradient(45deg, #a9855c, #6f5539);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .location {
        font-size: 1rem;
        color: #6b6b6b;
    }

    /* グラデーション文字は強制カラーモードで不可視になるため、通常の文字色に戻す */
    @media (forced-colors: active) {
        .name {
            background: none;
            -webkit-text-fill-color: currentColor;
            color: CanvasText;
        }
    }

    @media (max-width: 768px) {
        .hero {
            padding: 2rem 1.5rem;
        }
    }
</style>